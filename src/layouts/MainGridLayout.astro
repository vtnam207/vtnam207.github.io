---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import Profile from "../components/widget/Profile.astro";
import { profileConfig, siteConfig } from "../config";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/700.css";
import "@fontsource-variable/jetbrains-mono";
import "katex/dist/katex.css";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/expressive-code.css";
import "../styles/ctf-layout.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	showProfile?: boolean;
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const posts = await getSortedPosts();
const groups = new Set(
	posts.map((post) => post.data.ctf || post.data.category || "Notes"),
);
const activeDays = new Set(
	posts
		.slice(0, 4)
		.map((post) => post.data.published.toISOString().slice(0, 10)),
).size;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const toc = headings.filter(
	(heading) => heading.depth > 1 && heading.depth <= siteConfig.toc.depth + 1,
);
const isArticle = Boolean(setOGTypeArticle);
---
<!doctype html>
<html lang={(lang || siteConfig.lang).replace("_", "-")} class="dark" style="--hue: 285">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#100d18" />
    <script is:inline>
      try {
        if (localStorage.getItem("vtnam-theme") === "light") {
          document.documentElement.classList.remove("dark");
          document.documentElement.style.colorScheme = "light";
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#f8f5fd");
        }
      } catch (_) { /* Keep the default dark theme when storage is unavailable. */ }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description || siteConfig.subtitle} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || siteConfig.subtitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <link rel="icon" type="image/svg+xml" href={url("/ctf-mark.svg")} />
    <slot name="head" />
  </head>
  <body>
    <a href="#reading-pane" class="skip-link">Đến nội dung</a>
    {isArticle && <div class="reading-progress" aria-hidden="true"><span id="reading-progress-value"></span></div>}
    <header class="site-header">
      <a class="site-brand" href={url("/")}><span aria-hidden="true">✦</span> vtnam_</a>
      <nav aria-label="Main navigation">
        <a href={url("/about/")}><Icon name="fa6-regular:user" /> ABOUT</a>
        <a href={url("/archive/")}><Icon name="fa6-regular:folder-open" /> ARCHIVE</a>
        <span class="nav-divider"></span>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light mode" aria-pressed="true" title="Toggle dark and light mode"><span class="theme-moon" aria-hidden="true">☾</span><span class="theme-sun" aria-hidden="true">☀</span></button>
      </nav>
    </header>
    <div class="ctf-shell">
      <aside class="profile-sidebar" aria-label="Profile">
        <Profile />
        <div class="focus-section">
          <div class="focus-tags"><span>CTF</span><span>RE</span><span>CRYPTO</span></div>
        </div>
        <section class="learning-card" aria-label="Currently learning">
          <div class="learning-title"><Icon name="fa6-solid:graduation-cap" /><span>Currently learning</span></div>
          <p>x64 / VM / Web Exploit / Crypto</p>
          <div class="learning-progress" role="img" aria-label="Learning progress: 62 percent"><span></span></div>
          <span class="learning-percent">62%</span>
        </section>
        <div class="profile-stats" aria-label="Blog statistics">
          <div><Icon name="fa6-regular:note-sticky" /><strong>{posts.length}</strong><span>Posts</span></div>
          <div><Icon name="fa6-solid:users" /><strong>{groups.size}</strong><span>Groups</span></div>
          <div><Icon name="fa6-solid:fire" /><strong>{activeDays}</strong><span>Active Days</span></div>
        </div>
        <section class="social-section">
          <p class="social-heading"><Icon name="fa6-solid:link" /> Socials</p>
          <div class="social-icons">
            {profileConfig.links.map((item) => <a rel="me noopener noreferrer" aria-label={item.name} href={item.url} target="_blank" title={item.name}><Icon name={item.icon} /><span>↗</span></a>)}
          </div>
        </section>
        <blockquote class="sidebar-quote"><span aria-hidden="true">“</span><p>putting all my effort into RE</p><span class="quote-spark" aria-hidden="true">♧</span></blockquote>
        <div class="sidebar-landscape" aria-hidden="true"></div>
      </aside>

      <main id="reading-pane" tabindex="-1" class:list={["reading-pane", { "has-toc": siteConfig.toc.enable && toc.length > 0 }]}>
        <div class="reader-grid">
          <div class="reader-content"><slot /></div>
          {siteConfig.toc.enable && toc.length > 0 && <nav id="toc" class="reader-toc" aria-label="Mục lục"><p>ON THIS PAGE</p>{toc.map((heading) => <a class:list={[{ subheading: heading.depth > 2 }]} href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}
        </div>
        <footer class="reader-footer"><span>© {new Date().getFullYear()} {profileConfig.name} <b>—</b> Built with Astro & Tailwind CSS</span><nav aria-label="Footer links"><a href="https://github.com/vtnam207" target="_blank" rel="noopener noreferrer">GitHub</a><a href={url("/about/")}>About</a><a href={url("/archive/")}>Archive</a></nav></footer>
      </main>
    </div>
  </body>
</html>

<script>
const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
const updateThemeButton = () => {
  const dark = document.documentElement.classList.contains("dark");
  themeToggle?.setAttribute("aria-pressed", String(dark));
  themeToggle?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
};
updateThemeButton();
themeToggle?.addEventListener("click", () => {
  const dark = document.documentElement.classList.toggle("dark");
  document.documentElement.style.colorScheme = dark ? "dark" : "light";
  document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#100e24" : "#f8f5fd");
  try { localStorage.setItem("vtnam-theme", dark ? "dark" : "light"); } catch (_) { /* Theme still changes for this page. */ }
  updateThemeButton();
});

const search = document.querySelector<HTMLInputElement>("#home-post-search");
search?.addEventListener("input", () => {
  const query = search.value.toLocaleLowerCase().trim();
  let visible = 0;
  for (const card of document.querySelectorAll<HTMLElement>("[data-post-card]")) {
    const matches = !query || (card.dataset.search || "").includes(query);
    card.hidden = !matches;
    if (matches) visible++;
  }
  const empty = document.querySelector<HTMLElement>("#empty-post-search");
  if (empty) empty.hidden = visible > 0;
});

document.addEventListener("keydown", (event) => {
  if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
    event.preventDefault();
    search?.focus();
  }
});

const progress = document.querySelector<HTMLElement>("#reading-progress-value");
if (progress) {
  const updateProgress = () => {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const percent = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
    progress.style.width = `${Math.min(100, Math.max(0, percent))}%`;
  };
  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("resize", updateProgress);
  updateProgress();
}

const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".reader-toc a")];
if (tocLinks.length && "IntersectionObserver" in window) {
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) if (entry.isIntersecting) {
      tocLinks.forEach((link) => link.classList.toggle("active", decodeURIComponent(link.hash.slice(1)) === entry.target.id));
    }
  }, { rootMargin: "0px 0px -65% 0px" });
  tocLinks.forEach((link) => {
    const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (target) observer.observe(target);
  });
}
</script>
