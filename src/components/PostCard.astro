---
import { themeForCategory } from "../config";
import { formatDate, isoDate } from "../lib/format";
import { coverFor, facetSlug, type Post, urlOf } from "../lib/posts";
import Icon from "./Icon.astro";

interface Props {
	post: Post;
	variant?: "card" | "feature" | "row";
	/** Above-the-fold cards load eagerly to avoid LCP delay. */
	eager?: boolean;
	minutes?: number;
	index?: number;
}

const {
	post,
	variant = "card",
	eager = false,
	minutes,
	index = 0,
} = Astro.props;
const { title, description, category, tags, ctf, published, coverAlt } =
	post.data;
const href = urlOf(post);
const cover = coverFor(post);
const hue = themeForCategory(category).hue;
const delay = `animation-delay: ${Math.min(index, 8) * 60}ms; --chip-h: ${hue}; --card-h: ${hue};`;
---

{
	variant === "row" ? (
		<a href={href} class="row rise" style={delay}>
			<time datetime={isoDate(published)} class="row-date">
				{formatDate(published)}
			</time>
			<img src={cover} alt="" class="row-thumb" loading="lazy" decoding="async" width="128" height="72" />
			<span class="row-main">
				<span class="row-title">{title}</span>
				<span class="row-meta">
					<span class="chip chip-accent">{category}</span>
					{ctf && <span class="row-ctf">{ctf}</span>}
				</span>
			</span>
			<Icon name="arrow-right" size={18} class="row-arrow" />
		</a>
	) : (
		<article class:list={["card post-card rise", variant]} style={delay}>
			<a href={href} class="cover-link" tabindex="-1" aria-hidden="true">
				<div class="cover">
					<img
						src={cover}
						alt={coverAlt || ""}
						loading={eager ? "eager" : "lazy"}
						fetchpriority={eager ? "high" : undefined}
						decoding="async"
						width="1280"
						height="720"
					/>
				</div>
			</a>
			<div class="body">
				<div class="meta">
					<a href={`/categories/${facetSlug(category ?? "")}/`} class="chip chip-accent">
						{category}
					</a>
					{ctf && (
						<span class="meta-item">
							<Icon name="flag" size={13} />
							{ctf}
						</span>
					)}
				</div>

				<h3 class="title">
					<a href={href}>{title}</a>
				</h3>
				{description && <p class="desc">{description}</p>}

				<div class="foot">
					<span class="meta-item">
						<Icon name="calendar" size={13} />
						<time datetime={isoDate(published)}>{formatDate(published)}</time>
					</span>
					{minutes && (
						<span class="meta-item">
							<Icon name="clock" size={13} />
							{minutes} phút
						</span>
					)}
					{variant === "feature" && tags.length > 0 && (
						<span class="tags">
							{tags.slice(0, 4).map((t) => (
								<a href={`/tags/${facetSlug(t)}/`} class="tag">
									#{t}
								</a>
							))}
						</span>
					)}
					<Icon name="arrow-up-right" size={18} class="go" />
				</div>
			</div>
		</article>
	)
}

<style>
	/* ---------- card ---------- */
	.post-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition:
			transform 320ms var(--ease-out),
			border-color 320ms var(--ease-out),
			box-shadow 320ms var(--ease-out);
	}
	.post-card:hover {
		transform: translateY(-4px);
		border-color: hsl(var(--card-h) 70% 65% / 0.4);
		box-shadow: var(--shadow-lg), 0 0 0 1px hsl(var(--card-h) 70% 65% / 0.08);
	}

	.cover {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface-2);
		border-bottom: 1px solid var(--line);
	}
	.cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 700ms var(--ease-out), filter 700ms var(--ease-out);
	}
	.post-card:hover .cover img {
		transform: scale(1.045);
		filter: saturate(1.15) brightness(1.06);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.15rem 1.25rem 1.2rem;
		flex: 1;
	}
	.meta,
	.foot {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 0.9rem;
	}
	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-faint);
	}

	.title {
		font-size: 1.15rem;
		line-height: 1.3;
		color: var(--fg);
	}
	/* Whole-card click target without nesting interactive elements. */
	.title a::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
	}
	.meta a,
	.tags a {
		position: relative;
		z-index: 2;
	}
	.desc {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--fg-dim);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.foot {
		margin-top: auto;
		padding-top: 0.4rem;
	}
	.go {
		margin-left: auto;
		color: var(--fg-faint);
		transition: transform 300ms var(--ease-out), color 300ms var(--ease-out);
	}
	.post-card:hover .go {
		color: hsl(var(--card-h) 85% 72%);
		transform: translate(2px, -2px);
	}
	.tags {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-faint);
		transition: color 160ms;
	}
	.tag:hover { color: var(--accent); }

	/* ---------- feature: cover left, body right ---------- */
	.feature {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
	}
	.feature .cover {
		height: 100%;
		aspect-ratio: auto;
		min-height: 300px;
		border-bottom: none;
		border-right: 1px solid var(--line);
	}
	.feature .cover-link { display: block; height: 100%; }
	.feature .body {
		padding: clamp(1.4rem, 3vw, 2.2rem);
		gap: 0.95rem;
		justify-content: center;
	}
	.feature .title {
		font-size: clamp(1.45rem, 2.6vw, 1.95rem);
		letter-spacing: -0.028em;
	}
	.feature .desc {
		font-size: 0.98rem;
		-webkit-line-clamp: 4;
	}
	@media (max-width: 820px) {
		.feature { grid-template-columns: 1fr; }
		.feature .cover { aspect-ratio: 16 / 9; min-height: 0; border-right: none; border-bottom: 1px solid var(--line); }
	}

	/* ---------- row: compact list item ---------- */
	.row {
		display: grid;
		grid-template-columns: 7.5rem 96px 1fr auto;
		align-items: center;
		gap: 1.1rem;
		padding: 0.85rem 0.9rem;
		margin-inline: -0.9rem;
		border-radius: 12px;
		transition: background 200ms var(--ease-out);
	}
	.row:hover { background: var(--surface); }
	.row-date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--fg-faint);
	}
	.row-thumb {
		width: 96px;
		height: 54px;
		object-fit: cover;
		border-radius: 7px;
		border: 1px solid var(--line);
	}
	.row-main {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.row-title {
		font-weight: 600;
		color: var(--fg);
		line-height: 1.35;
	}
	.row-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.row-ctf {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--fg-faint);
	}
	.row :global(.row-arrow) {
		color: var(--fg-faint);
		transition: transform 260ms var(--ease-out), color 260ms;
	}
	.row:hover :global(.row-arrow) {
		color: var(--accent);
		transform: translateX(3px);
	}
	@media (max-width: 640px) {
		.row { grid-template-columns: 80px 1fr; gap: 0.85rem; }
		.row-date, .row :global(.row-arrow) { display: none; }
		.row-thumb { width: 80px; height: 45px; }
	}
</style>
