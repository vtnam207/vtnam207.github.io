---
import Icon from "./Icon.astro";
---

<div class="palette" data-palette hidden>
	<div class="palette-backdrop" data-palette-close></div>
	<div class="palette-panel" role="dialog" aria-modal="true" aria-label="Tìm kiếm bài viết">
		<div class="palette-input-row">
			<Icon name="search" size={18} />
			<input
				type="search"
				class="palette-input"
				placeholder="Tìm bài viết, tag, CTF, nội dung…"
				autocomplete="off"
				spellcheck="false"
				aria-controls="palette-results"
				data-palette-input
			/>
			<kbd class="kbd" data-palette-close>Esc</kbd>
		</div>
		<ul id="palette-results" class="palette-results" role="listbox" data-palette-results></ul>
		<div class="palette-footer">
			<span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> chọn</span>
			<span><kbd class="kbd">↵</kbd> mở</span>
			<span class="palette-count" data-palette-count></span>
		</div>
	</div>
</div>

<style>
	.palette {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding: min(14vh, 8rem) 1rem 1rem;
	}
	.palette[hidden] { display: none; }
	.palette-backdrop {
		position: absolute;
		inset: 0;
		background: hsl(230 30% 3% / 0.62);
		backdrop-filter: blur(4px);
		animation: fade 160ms var(--ease-out);
	}
	.palette-panel {
		position: relative;
		width: 100%;
		max-width: 640px;
		max-height: min(70vh, 620px);
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg), 0 0 0 1px var(--accent-soft);
		overflow: hidden;
		animation: pop 220ms var(--ease-out);
	}
	@keyframes fade { from { opacity: 0; } }
	@keyframes pop { from { opacity: 0; transform: translateY(-8px) scale(0.985); } }

	.palette-input-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0 1rem;
		border-bottom: 1px solid var(--line);
		color: var(--fg-faint);
	}
	.palette-input {
		flex: 1;
		height: 56px;
		font: inherit;
		font-size: 1rem;
		color: var(--fg);
		background: transparent;
		border: 0;
		outline: 0;
	}
	.palette-input::-webkit-search-cancel-button { display: none; }
	.palette-input-row .kbd { cursor: pointer; }

	.palette-results {
		list-style: none;
		margin: 0;
		padding: 0.5rem;
		overflow-y: auto;
		flex: 1;
	}
	.palette-results :global(.res) {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
		padding: 0.7rem 0.75rem;
		border-radius: 10px;
		cursor: pointer;
		color: var(--fg-dim);
	}
	.palette-results :global(.res[aria-selected="true"]) {
		background: var(--accent-soft);
		color: var(--fg);
	}
	.palette-results :global(.res-thumb) {
		width: 64px;
		height: 36px;
		flex-shrink: 0;
		border-radius: 6px;
		object-fit: cover;
		border: 1px solid var(--line);
		background: var(--surface-2);
	}
	.palette-results :global(.res-body) { min-width: 0; flex: 1; }
	.palette-results :global(.res-title) {
		font-weight: 600;
		color: var(--fg);
		font-size: 0.92rem;
		line-height: 1.35;
	}
	.palette-results :global(.res-meta) {
		margin-top: 0.15rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--fg-faint);
		letter-spacing: 0.02em;
	}
	.palette-results :global(.res-snippet) {
		margin-top: 0.3rem;
		font-size: 0.82rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.palette-results :global(mark) {
		background: var(--accent-soft);
		color: var(--accent);
		border-radius: 3px;
		padding: 0 1px;
	}
	.palette-results :global(.res-empty),
	.palette-results :global(.res-section) {
		padding: 0.5rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg-faint);
	}
	.palette-results :global(.res-empty) {
		padding: 2.5rem 1rem;
		text-align: center;
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.85rem;
	}
	.palette-footer {
		display: flex;
		gap: 1rem;
		padding: 0.6rem 1rem;
		border-top: 1px solid var(--line);
		font-size: 0.75rem;
		color: var(--fg-faint);
		background: var(--surface-2);
	}
	.palette-footer .kbd { margin-right: 0.2rem; }
	.palette-count { margin-left: auto; font-family: var(--font-mono); }
</style>

<script>
	interface Doc {
		title: string;
		url: string;
		description: string;
		category: string;
		ctf: string;
		tags: string[];
		date: string;
		cover: string;
		body: string;
	}

	/** Lowercase and strip Vietnamese diacritics so "ma hoa" finds "mã hóa". */
	const fold = (s: string) =>
		s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/g, "d");

	const escapeHtml = (s: string) =>
		s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

	/**
	 * Highlight `terms` inside `text`. Matching runs on the folded string and
	 * slices come from the original: for NFC Vietnamese text each precomposed
	 * letter folds to exactly one base letter, so indices line up. If they
	 * ever don't, we skip highlighting rather than mark the wrong span.
	 */
	function highlight(text: string, terms: string[]): string {
		if (!terms.length) return escapeHtml(text);
		const folded = fold(text);
		const ranges: [number, number][] = [];
		const isWordChar = (c: string | undefined) => !!c && /[a-z0-9]/.test(c);
		for (const t of terms) {
			let i = folded.indexOf(t);
			while (i !== -1) {
				if (!isWordChar(folded[i - 1])) ranges.push([i, i + t.length]);
				i = folded.indexOf(t, i + t.length);
			}
		}
		if (!ranges.length || folded.length !== text.length) return escapeHtml(text);
		ranges.sort((a, b) => a[0] - b[0]);
		let out = "";
		let pos = 0;
		for (const [s, e] of ranges) {
			if (s < pos) continue;
			out += escapeHtml(text.slice(pos, s)) + "<mark>" + escapeHtml(text.slice(s, e)) + "</mark>";
			pos = e;
		}
		return out + escapeHtml(text.slice(pos));
	}

	function snippet(body: string, terms: string[]): string {
		// Prefer the whole phrase, then the first word-start hit of any term.
		const folded = ` ${fold(body).replace(/[^a-z0-9]/g, " ")}`;
		let at = folded.indexOf(` ${terms.join(" ")}`);
		for (const t of terms) {
			if (at !== -1) break;
			at = folded.indexOf(` ${t}`);
		}
		if (at === -1) return body.slice(0, 160);
		const start = Math.max(0, at - 60);
		return (start > 0 ? "…" : "") + body.slice(start, start + 180).trim() + "…";
	}

	/** Word-start match, so "ma" finds "mã hóa" but not "Wanagame". */
	const hasWord = (field: string, t: string) => field.includes(` ${t}`);

	function score(doc: Doc & { _f: Record<string, string> }, terms: string[]): number {
		let total = 0;
		for (const t of terms) {
			let s = 0;
			if (hasWord(doc._f.title, t)) s += doc._f.title.startsWith(` ${t}`) ? 12 : 8;
			if (hasWord(doc._f.tags, t)) s += 6;
			if (hasWord(doc._f.meta, t)) s += 5;
			if (hasWord(doc._f.description, t)) s += 3;
			if (hasWord(doc._f.body, t)) s += 1;
			if (s === 0) return 0; // every term must match somewhere
			total += s;
		}
		// The exact phrase beats the same words scattered around.
		if (terms.length > 1) {
			const phrase = ` ${terms.join(" ")}`;
			if (doc._f.title.includes(phrase)) total += 20;
			if (doc._f.description.includes(phrase)) total += 8;
			const hits = doc._f.body.split(phrase).length - 1;
			total += Math.min(hits, 10);
		}
		return total;
	}

	let docs: (Doc & { _f: Record<string, string> })[] | null = null;
	async function load() {
		if (docs) return docs;
		const res = await fetch("/search.json");
		const raw: Doc[] = await res.json();
		// Leading space + punctuation-as-space makes word-start checks a plain includes().
		const words = (s: string) => ` ${fold(s).replace(/[^a-z0-9]+/g, " ")}`;
		docs = raw.map((d) => ({
			...d,
			_f: {
				title: words(d.title),
				tags: words(d.tags.join(" ")),
				meta: words(`${d.category} ${d.ctf}`),
				description: words(d.description),
				body: words(d.body),
			},
		}));
		return docs;
	}

	function initPalette() {
		const root = document.querySelector<HTMLElement>("[data-palette]");
		if (!root) return;
		const input = root.querySelector<HTMLInputElement>("[data-palette-input]")!;
		const list = root.querySelector<HTMLUListElement>("[data-palette-results]")!;
		const count = root.querySelector<HTMLElement>("[data-palette-count]")!;
		let selected = 0;
		let results: Doc[] = [];
		let lastFocus: Element | null = null;

		const render = (terms: string[]) => {
			if (!results.length) {
				list.innerHTML = `<li class="res-empty">${
					terms.length ? "Không tìm thấy bài nào khớp. Thử từ khoá khác?" : "Đang tải…"
				}</li>`;
				count.textContent = "";
				return;
			}
			const header = terms.length ? "" : `<li class="res-section" role="presentation">Bài mới nhất</li>`;
			list.innerHTML =
				header +
				results
					.map(
						(d, i) => `
				<li class="res" role="option" id="res-${i}" aria-selected="${i === selected}" data-url="${d.url}">
					<img class="res-thumb" src="${d.cover}" alt="" loading="lazy" />
					<div class="res-body">
						<div class="res-title">${highlight(d.title, terms)}</div>
						<div class="res-meta">${escapeHtml(d.date)} · ${escapeHtml(d.category)}${d.ctf ? " · " + escapeHtml(d.ctf) : ""}</div>
						<div class="res-snippet">${highlight(terms.length ? snippet(d.body, terms) : d.description, terms)}</div>
					</div>
				</li>`,
					)
					.join("");
			count.textContent = `${results.length} kết quả`;
			input.setAttribute("aria-activedescendant", `res-${selected}`);
		};

		const run = async () => {
			const all = await load();
			const terms = fold(input.value).replace(/[^a-z0-9]+/g, " ").split(" ").filter(Boolean);
			selected = 0;
			if (!terms.length) {
				results = all.slice(0, 6);
			} else {
				results = all
					.map((d) => ({ d, s: score(d, terms) }))
					.filter((x) => x.s > 0)
					.sort((a, b) => b.s - a.s)
					.slice(0, 20)
					.map((x) => x.d);
			}
			render(terms);
		};

		const open = () => {
			lastFocus = document.activeElement;
			root.hidden = false;
			document.body.style.overflow = "hidden";
			input.value = "";
			// Focus synchronously so keystrokes typed right after Ctrl+K aren't lost.
			input.focus();
			run();
		};
		const close = () => {
			root.hidden = true;
			document.body.style.overflow = "";
			(lastFocus as HTMLElement | null)?.focus?.();
		};
		const go = (i: number) => {
			const d = results[i];
			if (d) window.location.href = d.url;
		};
		const move = (delta: number) => {
			if (!results.length) return;
			selected = (selected + delta + results.length) % results.length;
			for (const el of list.querySelectorAll(".res")) {
				el.setAttribute("aria-selected", String(el.id === `res-${selected}`));
			}
			input.setAttribute("aria-activedescendant", `res-${selected}`);
			list.querySelector(`#res-${selected}`)?.scrollIntoView({ block: "nearest" });
		};

		for (const el of document.querySelectorAll("[data-search-open]")) el.addEventListener("click", open);
		for (const el of root.querySelectorAll("[data-palette-close]")) el.addEventListener("click", close);

		let t: number | undefined;
		input.addEventListener("input", () => {
			window.clearTimeout(t);
			t = window.setTimeout(run, 60);
		});
		input.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
			else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
			else if (e.key === "Enter") { e.preventDefault(); go(selected); }
		});
		list.addEventListener("click", (e) => {
			const li = (e.target as HTMLElement).closest<HTMLElement>(".res");
			if (li?.dataset.url) window.location.href = li.dataset.url;
		});
		list.addEventListener("mousemove", (e) => {
			const li = (e.target as HTMLElement).closest<HTMLElement>(".res");
			if (!li) return;
			const i = Number(li.id.replace("res-", ""));
			if (i !== selected) { selected = i; move(0); }
		});

		document.addEventListener("keydown", (e) => {
			const typing = (e.target as HTMLElement)?.closest?.("input, textarea, [contenteditable]");
			if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing && root.hidden)) {
				e.preventDefault();
				root.hidden ? open() : close();
			} else if (e.key === "Escape" && !root.hidden) {
				close();
			}
		});
	}
	initPalette();
</script>
