---
import { author, license, nav, site, socials } from "../config";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div class="footer-about">
			<a href="/" class="footer-brand">
				<span class="text-accent">~/</span>{site.shortTitle}
			</a>
			<p>
				Blog của <strong>{author.name}</strong> — sinh viên {author.schoolShort}. Ghi chép về reverse engineering,
				CTF và những thứ chạy ở tầng thấp.
			</p>
			<div class="footer-socials">
				{
					socials.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label={s.name} title={s.name}>
							<Icon name={s.icon as any} size={17} />
						</a>
					))
				}
				<a href="/rss.xml" class="social-btn" aria-label="RSS" title="RSS feed">
					<Icon name="rss" size={17} />
				</a>
			</div>
		</div>

		<div>
			<p class="mono-label">Điều hướng</p>
			<ul class="footer-list">
				{nav.map((n) => <li><a href={n.href} class="link-underline">{n.label}</a></li>)}
			</ul>
		</div>

		<div>
			<p class="mono-label">Khám phá</p>
			<ul class="footer-list">
				<li><a href="/tags/" class="link-underline">Tags</a></li>
				<li><a href="/rss.xml" class="link-underline">RSS feed</a></li>
				<li><a href="/sitemap-index.xml" class="link-underline">Sitemap</a></li>
				<li><a href="https://github.com/vtnam207/vtnam207.github.io" target="_blank" rel="noopener" class="link-underline">Source</a></li>
			</ul>
		</div>
	</div>

	<div class="shell footer-bottom">
		<span>© {year} {author.name}</span>
		{
			license.enable && (
				<span>
					Nội dung theo giấy phép{" "}
					<a href={license.url} target="_blank" rel="noopener" class="link-underline">
						{license.name}
					</a>
				</span>
			)
		}
		<span class="footer-motto">"{author.motto}"</span>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 6rem;
		border-top: 1px solid var(--line);
		background: var(--bg-soft);
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 3rem;
		padding-block: 3.5rem 2.5rem;
	}
	.footer-brand {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--fg);
	}
	.text-accent { color: var(--accent); }
	.footer-about p {
		margin: 0.85rem 0 1.25rem;
		max-width: 34rem;
		color: var(--fg-dim);
		font-size: 0.9rem;
	}
	.footer-about strong { color: var(--fg); font-weight: 600; }
	.footer-socials {
		display: flex;
		gap: 0.5rem;
	}
	.social-btn {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 10px;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--fg-dim);
		transition: all 180ms var(--ease-out);
	}
	.social-btn:hover {
		color: var(--accent);
		border-color: var(--accent-line);
		transform: translateY(-2px);
	}
	.footer-list {
		list-style: none;
		margin: 0.9rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
		font-size: 0.9rem;
		color: var(--fg-dim);
	}
	.footer-list a:hover { color: var(--fg); }
	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding-block: 1.25rem 2rem;
		border-top: 1px solid var(--line-soft);
		font-size: 0.8rem;
		color: var(--fg-faint);
		font-family: var(--font-mono);
	}
	.footer-motto { margin-left: auto; font-style: italic; }
	@media (max-width: 760px) {
		.footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
		.footer-about { grid-column: 1 / -1; }
		.footer-motto { margin-left: 0; }
	}
</style>
