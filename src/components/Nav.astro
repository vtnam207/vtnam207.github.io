---
import { nav, site } from "../config";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/"
		? path === "/"
		: path.startsWith(href) ||
			(href === "/blog/" && path.startsWith("/posts/"));
---

<header class="site-nav" data-nav>
	<div class="shell nav-inner">
		<a href="/" class="brand" aria-label={`${site.title} — trang chủ`}>
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 32 32" width="28" height="28">
					<rect x="1" y="1" width="30" height="30" rx="8" fill="var(--accent-soft)" stroke="var(--accent-line)" />
					<path d="M9 11l5 5-5 5" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M16.5 21H23" stroke="var(--fg)" stroke-width="2.4" stroke-linecap="round" />
				</svg>
			</span>
			<span class="brand-text">
				<span class="brand-prompt">~/</span>{site.shortTitle}<span class="caret" aria-hidden="true"></span>
			</span>
		</a>

		<nav class="nav-links" aria-label="Chính">
			{
				nav.map((item) => (
					<a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="nav-actions">
			<button type="button" class="search-trigger" data-search-open aria-label="Tìm kiếm (Ctrl K)">
				<Icon name="search" size={16} />
				<span class="search-trigger-text">Tìm kiếm…</span>
				<kbd class="kbd"><span data-mod-key>Ctrl</span> K</kbd>
			</button>
			<button type="button" class="icon-btn" data-theme-toggle aria-label="Đổi giao diện sáng/tối">
				<Icon name="sun" size={18} class="theme-icon-sun" />
				<Icon name="moon" size={18} class="theme-icon-moon" />
			</button>
			<button type="button" class="icon-btn nav-menu-btn" data-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
				<Icon name="menu" size={20} class="menu-open" />
				<Icon name="close" size={20} class="menu-close" />
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
		<nav class="shell" aria-label="Di động">
			{
				nav.map((item) => (
					<a href={item.href} class:list={["mobile-link", { active: isActive(item.href) }]}>
						<span>{item.label}</span>
						<Icon name="arrow-right" size={16} />
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--nav-height);
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: saturate(160%) blur(14px);
		-webkit-backdrop-filter: saturate(160%) blur(14px);
		border-bottom: 1px solid transparent;
		transition: border-color 240ms var(--ease-out), background 240ms var(--ease-out);
	}
	.site-nav[data-scrolled] {
		border-bottom-color: var(--line);
	}

	.nav-inner {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--fg);
		flex-shrink: 0;
	}
	.brand-mark svg {
		transition: transform 400ms var(--ease-out);
	}
	.brand:hover .brand-mark svg {
		transform: rotate(-8deg) scale(1.05);
	}
	.brand-prompt {
		color: var(--accent);
	}
	.caret {
		display: inline-block;
		width: 0.5em;
		height: 1.05em;
		margin-left: 2px;
		vertical-align: -0.17em;
		background: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% { opacity: 0; }
	}

	.nav-links {
		display: flex;
		gap: 0.15rem;
		margin-left: 0.5rem;
	}
	.nav-link {
		position: relative;
		padding: 0.4rem 0.75rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--fg-dim);
		border-radius: 8px;
		transition: color 160ms var(--ease-out), background 160ms var(--ease-out);
	}
	.nav-link:hover {
		color: var(--fg);
		background: var(--surface-2);
	}
	.nav-link.active {
		color: var(--fg);
	}
	.nav-link.active::after {
		content: "";
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: -11px;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
	}

	.nav-actions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		height: 36px;
		padding: 0 0.5rem 0 0.75rem;
		min-width: 220px;
		font: inherit;
		font-size: 0.85rem;
		color: var(--fg-faint);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 9px;
		cursor: pointer;
		transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out);
	}
	.search-trigger:hover {
		border-color: var(--accent-line);
		color: var(--fg-dim);
	}
	.search-trigger-text {
		flex: 1;
		text-align: left;
	}

	.icon-btn {
		display: inline-grid;
		place-items: center;
		width: 36px;
		height: 36px;
		color: var(--fg-dim);
		background: transparent;
		border: 1px solid transparent;
		border-radius: 9px;
		cursor: pointer;
		transition: all 160ms var(--ease-out);
	}
	.icon-btn:hover {
		color: var(--fg);
		background: var(--surface-2);
		border-color: var(--line);
	}

	/* Theme icon: show the icon of the theme you'd switch TO. */
	:global(:root:not([data-theme="light"])) .icon-btn :global(.theme-icon-moon),
	:global(:root[data-theme="light"]) .icon-btn :global(.theme-icon-sun) {
		display: none;
	}

	.nav-menu-btn { display: none; }
	.nav-menu-btn :global(.menu-close) { display: none; }
	.nav-menu-btn[aria-expanded="true"] :global(.menu-open) { display: none; }
	.nav-menu-btn[aria-expanded="true"] :global(.menu-close) { display: block; }

	.mobile-menu {
		position: absolute;
		top: var(--nav-height);
		left: 0;
		right: 0;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		padding: 0.5rem 0 1rem;
		box-shadow: var(--shadow-lg);
	}
	.mobile-menu[hidden] { display: none; }
	.mobile-link {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 0.25rem;
		font-weight: 500;
		color: var(--fg-dim);
		border-bottom: 1px solid var(--line-soft);
	}
	.mobile-link.active { color: var(--accent); }

	@media (max-width: 900px) {
		.search-trigger { min-width: 0; padding: 0; width: 36px; justify-content: center; }
		.search-trigger-text, .search-trigger .kbd { display: none; }
	}
	@media (max-width: 760px) {
		.nav-links { display: none; }
		.nav-menu-btn { display: inline-grid; }
	}
</style>

<script>
	function initNav() {
		const nav = document.querySelector<HTMLElement>("[data-nav]");
		if (!nav) return;

		const onScroll = () => nav.toggleAttribute("data-scrolled", window.scrollY > 8);
		onScroll();
		window.addEventListener("scroll", onScroll, { passive: true });

		const btn = nav.querySelector<HTMLButtonElement>("[data-menu-toggle]");
		const menu = nav.querySelector<HTMLElement>("[data-mobile-menu]");
		btn?.addEventListener("click", () => {
			const open = btn.getAttribute("aria-expanded") === "true";
			btn.setAttribute("aria-expanded", String(!open));
			if (menu) menu.hidden = open;
		});

		// Show the right modifier key in the search hint.
		if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
			for (const el of document.querySelectorAll("[data-mod-key]")) el.textContent = "⌘";
		}

		document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
			const root = document.documentElement;
			const next = root.dataset.theme === "light" ? "dark" : "light";
			root.classList.add("theme-transition");
			root.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch {}
			window.setTimeout(() => root.classList.remove("theme-transition"), 260);
		});
	}
	initNav();
</script>
